# ======================================================================
# FoleniChap - copy to .env and fill in.  NEVER commit .env
# ======================================================================
DOMAIN=folenichap.co.tz
PUBLIC_BASE_URL=https://folenichap.co.tz
CORS_ALLOWED_ORIGINS=https://folenichap.co.tz,https://www.folenichap.co.tz

# ---- Online PostgreSQL (pick ONE provider) ----------------------------
# Neon:   pooled URL for the app, direct URL for Flyway migrations
DB_URL=jdbc:postgresql://ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DB_MIGRATION_URL=jdbc:postgresql://ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Supabase (session pooler, port 5432, works for both):
# DB_URL=jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
# DB_MIGRATION_URL=
DB_USERNAME=neondb_owner
DB_PASSWORD=
DB_POOL_SIZE=8

# ---- Security ----------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=
SUPER_ADMIN_EMAIL=you@folenichap.co.tz
SUPER_ADMIN_PASSWORD=ChangeThisStrongPassword!
REQUIRE_TENANT_APPROVAL=false
# Only for Vercel -> Render hosting (see DEPLOY_VERCEL_RENDER.md). Leave empty on a VPS with nginx.
PROXY_SHARED_SECRET=
# Swagger UI at /swagger-ui.html - keep false in production
API_DOCS_ENABLED=false
# Refresh-token cookie Secure flag (keep true; browsers allow it on http://localhost)
REFRESH_COOKIE_SECURE=true
JWT_ACCESS_MINUTES=15

# ---- Redis (docker-compose service) ------------------------------------
REDIS_URL=redis://redis:6379
FOLENI_SSE_REDIS_RELAY=false

# ---- Payments: MOCK for testing, AZAMPAY for real money ----------------
PAYMENT_GATEWAY=MOCK
# MOCK auto-approves payments: development only. The backend refuses MOCK unless this is true.
ALLOW_MOCK_PAYMENTS=false
# openssl rand -hex 24 ; callback URL = https://DOMAIN/api/v1/webhooks/payments/azampay?token=<this>
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SIGNATURE_HEADER=X-Signature
PAYMENT_WEBHOOK_ALLOWED_IPS=
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_API_KEY=
AZAMPAY_AUTH_URL=https://authenticator-sandbox.azampay.co.tz
AZAMPAY_CHECKOUT_URL=https://sandbox.azampay.co.tz

# ---- WhatsApp Cloud API ------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_BOOKED=foleni_ticket_booked
WHATSAPP_TEMPLATE_NEAR=foleni_near_turn
WHATSAPP_TEMPLATE_CALLED=foleni_called
# optional; empty = these go by SMS until the templates are approved by Meta
WHATSAPP_TEMPLATE_APPT_BOOKED=
WHATSAPP_TEMPLATE_APPT_REMINDER=
WHATSAPP_TEMPLATE_PASSWORD_RESET=

# ---- Beem Africa SMS (fallback) ----------------------------------------
SMS_ENABLED=false
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=FOLENICHAP
